<?xml version="1.0" encoding="utf-8"?><!--
  Android 12+ 的备份 / 换机规则。

  与 backup_rules.xml 同一原则：**凭据不进默认备份**（Keystore 密钥不可导出，
  备份过去也解不开），数据库与普通设置允许备份，临时目录排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="settings_global.xml" />
        <include domain="sharedpref" path="settings_jm.xml" />
        <include domain="sharedpref" path="settings_bili.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="tmp" />
        <exclude domain="file" path="export" />
        <exclude domain="file" path="crash" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="settings_global.xml" />
        <include domain="sharedpref" path="settings_jm.xml" />
        <include domain="sharedpref" path="settings_bili.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="tmp" />
        <exclude domain="file" path="export" />
        <exclude domain="file" path="crash" />
    </device-transfer>
</data-extraction-rules>
